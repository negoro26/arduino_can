# compile_commands.json is generated by `pio run -t compiledb` and describes an
# arm-none-eabi-g++ cross build. clangd runs as x86 clang but understands the
# GCC ARM machine flags (-mcpu=cortex-m0plus, -mthumb) directly, so they are
# deliberately left alone -- stripping them makes clang fall back to armv4t and
# produces far more errors than it fixes.
CompileFlags:
  CompilationDatabase: .
  Add:
    # Suppress (below) hides a diagnostic from the editor but clang still
    # COUNTS it against its default 20-error limit, then emits the fatal
    # "too many errors emitted, stopping now" at line 1 -- which is itself not
    # suppressible.
    - -ferror-limit=0

Diagnostics:
  Suppress:
    # CMSIS device headers declare anonymous bit-fields carrying the
    # volatile-based __I / __O / __IO qualifiers. GCC accepts this; clang treats
    # it as an error and then aborts the translation unit, so every symbol in
    # the file shows up undefined.
    - anon_bitfield_qualifiers

---
# Test files are NOT in compile_commands.json: `pio run -t compiledb` only
# describes the firmware build, and these are host tests built by
# `pio test -e native`.
If:
  PathMatch: test/.*
CompileFlags:
  Add:
    - -std=c++17
    - -I.pio/libdeps/native/Unity/src
    - -Ilib/elm/src
    - -Ilib/vecu/src
    - -Itest/support
